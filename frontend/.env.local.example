# Optional but recommended before deploying: a dedicated Base Sepolia RPC.
# Without it the app falls back to the public endpoint, which rate-limits.
# Set this same variable in Vercel's project settings.
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=

# Optional. Pinata JWT for pinning certificate metadata and artwork to IPFS.
# SERVER-SIDE ONLY - never prefix this with NEXT_PUBLIC_, or it ships to every
# visitor's browser. Without it, metadata is embedded inline instead.
PINATA_JWT=

# Optional. Gateway used to read ipfs:// URIs back.
NEXT_PUBLIC_IPFS_GATEWAY=
